
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d18">
<meta name="description" content="ACHIVEST - Learn. Trade. Achieve. Professional trading education in Forex, Gold and Crypto.">
<title>ACHIVEST | Learn. Trade. Achieve.</title>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --blue: #1558ef;
  --blue-light: #377bff;
  --navy: #080d18;
  --navy2: #101a2b;
  --white: #ffffff;
  --muted: #9daac0;
  --border: rgba(255,255,255,.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: 'DM Sans', sans-serif;
  background: #f5f7fb;
  color: #17243b;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

.topbar {
  background: #080d18;
  color: #c4d2ec;
  text-align: center;
  padding: 9px;
  font-size: 11px;
  letter-spacing: 1px;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,.97);
  border-bottom: 1px solid #e6eaf1;
  backdrop-filter: blur(15px);
}

.navbar {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo img {
  width: 145px;
  height: 72px;
  object-fit: contain;
  background: #000;
  border-radius: 5px;
  display: block;
}

nav {
  display: flex;
  align-items: center;
  gap: 30px;
}

nav a {
  color: #536078;
  font-size: 13px;
  font-weight: 700;
  transition: .2s;
}

nav a:hover {
  color: var(--blue);
}

.nav-button {
  background: var(--blue);
  color: white;
  padding: 13px 20px;
  border-radius: 6px;
}

.menu-btn {
  display: none;
  border: 0;
  background: none;
  font-size: 26px;
  cursor: pointer;
  color: #10203a;
}

/* HERO */

.hero {
  background:
    radial-gradient(circle at 85% 20%, #1c55bd26, transparent 35%),
    linear-gradient(135deg,#080d18,#101d35);
  padding: 105px 0 85px;
  color: white;
  position: relative;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 65px;
  align-items: center;
}

.eyebrow {
  font-size: 11px;
  color: #77a4ff;
  letter-spacing: 3px;
  font-weight: 700;
}

.hero h1 {
  font-family: Manrope,sans-serif;
  font-size: clamp(42px,5vw,68px);
  line-height: 1.12;
  letter-spacing: -2px;
  margin: 25px 0;
}

.hero h1 span {
  color: #4383ff;
}

.hero p {
  color: #b1bdd0;
  max-width: 550px;
  font-size: 15px;
  line-height: 1.9;
}

.buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.btn {
  padding: 15px 22px;
  display: inline-block;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  transition: .25s;
}

.btn-primary {
  background: var(--blue);
  color: white;
  box-shadow: 0 8px 25px #1558ef40;
}

.btn-primary:hover {
  background: #3475ff;
  transform: translateY(-3px);
}

.btn-outline {
  border: 1px solid #66758e;
  color: white;
}

.btn-outline:hover {
  border-color: #4383ff;
  color: #78a5ff;
}

.hero-logo {
  background: #000;
  padding: 9px;
  border-radius: 13px;
  border: 1px solid #ffffff20;
  box-shadow: 0 30px 90px #0008;
  max-width: 480px;
  margin: auto;
}

.hero-logo img {
  width: 100%;
  display: block;
  border-radius: 7px;
}

.hero-caption {
  padding: 14px 8px 5px;
  display: flex;
  justify-content: space-between;
  color: #b8c8e7;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.hero-stats {
  display: flex;
  gap: 35px;
  flex-wrap: wrap;
  margin-top: 48px;
}

.hero-stats strong {
  display: block;
  font: 800 22px Manrope;
  color: white;
}

.hero-stats span {
  color: #96a8c4;
  font-size: 11px;
}

/* TRUST STRIP */

.trust-strip {
  background: white;
  padding: 23px 0;
  border-bottom: 1px solid #e6eaf1;
}

.trust-items {
  display: flex;
  justify-content: space-around;
  gap: 20px;
  flex-wrap: wrap;
  color: #4c5b75;
  font-size: 11px;
  letter-spacing: 1px;
  font-weight: 700;
}

.trust-items span::before {
  content: "✓";
  color: var(--blue);
  margin-right: 8px;
}

/* GENERAL SECTIONS */

section.content {
  padding: 100px 0;
}

.section-title {
  font: 800 45px/1.2 Manrope,sans-serif;
  letter-spacing: -1.5px;
  color: #10203a;
  margin: 16px 0;
}

.section-title span {
  color: var(--blue);
}

.section-description {
  font-size: 14px;
  color: #758198;
  line-height: 1.9;
  max-width: 600px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-bottom: 45px;
}

.section-header > div,
.section-header > p {
  flex: 1;
}

.small-label {
  color: var(--blue);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
}

/* ABOUT */

.about {
  background: white;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.about-image {
  background: #000;
  padding: 10px;
  border-radius: 12px;
  box-shadow: 0 20px 60px #10203a1c;
}

.about-image img {
  width: 100%;
  display: block;
  border-radius: 7px;
}

.about-text p {
  color: #758198;
  font-size: 14px;
  line-height: 1.9;
  margin-top: 17px;
}

.about-points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-top: 28px;
}

.about-points div {
  padding: 13px;
  background: #f0f4fc;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 700;
  color: #233e70;
}

/* EXPERIENCE */

.experience {
  background: #eaf1ff;
  padding: 35px 0;
}

.experience-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  flex-wrap: wrap;
}

.experience-row strong {
  font: 800 32px Manrope;
  color: var(--blue);
}

.experience-row p {
  font-size: 13px;
  color: #53627a;
}

/* COURSES */

.courses {
  background: #f5f7fb;
}

.course-card {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  background: white;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #e2e8f2;
  box-shadow: 0 20px 50px #192c4910;
}

.course-intro {
  background: #101d35;
  padding: 40px;
  color: white;
}

.course-intro .tag {
  font-size: 10px;
  color: #82aaff;
  letter-spacing: 2px;
  font-weight: 700;
}

.course-intro h3 {
  font: 800 32px/1.25 Manrope;
  margin: 25px 0 15px;
}

.course-intro p {
  color: #b7c4d9;
  font-size: 13px;
  line-height: 1.8;
}

.course-details {
  display: flex;
  gap: 25px;
  flex-wrap: wrap;
  margin: 30px 0;
}

.course-details small {
  display: block;
  color: #92a9d1;
  font-size: 9px;
  letter-spacing: 1px;
}

.course-details strong {
  display: block;
  font-size: 12px;
  margin-top: 5px;
}

.curriculum {
  padding: 38px;
}

.curriculum h4 {
  font-size: 11px;
  letter-spacing: 2px;
  color: #70809b;
  margin-bottom: 20px;
}

.curriculum ul {
  list-style: none;
}

.curriculum li {
  border-bottom: 1px solid #edf0f5;
  padding: 12px 0;
  color: #30415d;
  font-size: 12px;
}

.curriculum li span {
  color: var(--blue);
  font-weight: 800;
  margin-right: 12px;
}

.course-note {
  font-size: 11px;
  color: #77849a;
  margin-top: 18px;
}

/* LEARNING METHOD */

.method {
  background: white;
}

.method-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 16px;
  margin-top: 40px;
}

.method-card {
  background: #f6f8fc;
  border: 1px solid #e3e9f2;
  border-radius: 9px;
  padding: 27px 21px;
  transition: .25s;
}

.method-card:hover {
  transform: translateY(-6px);
  border-color: #8eafff;
  box-shadow: 0 15px 35px #153f8710;
}

.method-card .number {
  color: var(--blue);
  font: 800 12px Manrope;
}

.method-card h3 {
  font: 800 17px Manrope;
  color: #152641;
  margin: 25px 0 12px;
}

.method-card p {
  font-size: 12px;
  line-height: 1.8;
  color: #77849a;
}

/* QUOTE */

.quote-section {
  padding: 75px 0;
  background: linear-gradient(120deg,#101d35,#123778);
  color: white;
  text-align: center;
}

.quote-section h2 {
  font: 700 clamp(27px,4vw,40px) Manrope;
  line-height: 1.4;
}

.quote-section h2 span {
  color: #75a5ff;
}

.quote-section small {
  display: block;
  margin-top: 20px;
  color: #a8c2f3;
  letter-spacing: 2px;
  font-size: 9px;
}

/* FAQ */

.faqs {
  background: white;
}

.faq-list {
  max-width: 850px;
  margin: 35px auto 0;
}

.faq-list details {
  border-bottom: 1px solid #e5eaf2;
  padding: 19px 4px;
}

.faq-list summary {
  cursor: pointer;
  list-style: none;
  font: 700 14px Manrope;
  color: #1b2d49;
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary:after {
  content: "+";
  float: right;
  color: var(--blue);
  font-size: 20px;
}

.faq-list details[open] summary:after {
  content: "−";
}

.faq-list details p {
  color: #748198;
  font-size: 13px;
  line-height: 1.8;
  padding-top: 13px;
}

/* CONTACT */

.contact {
  background: #eaf0fb;
  padding: 85px 0;
}

.contact-box {
  background: white;
  border: 1px solid #dce5f2;
  border-radius: 13px;
  padding: 50px;
  display: grid;
  grid-template-columns: 1fr .7fr;
  gap: 35px;
  align-items: center;
}

.contact-box p {
  color: #748198;
  font-size: 14px;
  line-height: 1.8;
  margin: 17px 0 25px;
}

.contact-logo {
  background: black;
  padding: 8px;
  border-radius: 9px;
  max-width: 330px;
  justify-self: end;
}

.contact-logo img {
  width: 100%;
  display: block;
}

/* FOOTER */

footer {
  background: #080d18;
  color: white;
  padding: 45px 0 20px;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  flex-wrap: wrap;
}

.footer-logo {
  width: 135px;
  background: black;
  border-radius: 5px;
}

.footer-top p {
  color: #a5b2c9;
  font-size: 12px;
}

.disclaimer {
  border-top: 1px solid #ffffff19;
  border-bottom: 1px solid #ffffff19;
  margin-top: 30px;
  padding: 20px 0;
}

.disclaimer h4 {
  font-size: 10px;
  color: #83aaff;
  letter-spacing: 1px;
}

.disclaimer p {
  font-size: 10px;
  color: #98a7c0;
  line-height: 1.9;
  margin-top: 9px;
}

.copyright {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
  color: #7f8ba2;
  font-size: 10px;
  padding-top: 20px;
}

/* RESPONSIVE */

@media(max-width:900px) {
  .hero-grid {
    gap: 35px;
  }

  .method-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .section-header {
    gap: 25px;
  }
}

@media(max-width:650px) {
  .container {
    width: 90%;
  }

  .navbar {
    height: 72px;
  }

  .logo img {
    width: 115px;
    height: 62px;
  }

  .menu-btn {
    display: block;
  }

  nav {
    display: none;
    position: absolute;
    top: 71px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    background: white;
    padding: 23px 5%;
    gap: 20px;
    border-bottom: 1px solid #e5eaf2;
  }

  nav.open {
    display: flex;
  }

  .nav-button {
    text-align: center;
  }

  .hero {
    padding: 65px 0;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero p {
    font-size: 13px;
  }

  .hero-logo {
    max-width: 430px;
  }

  .hero-stats {
    gap: 25px;
  }

  section.content {
    padding: 70px 0;
  }

  .section-title {
    font-size: 37px;
  }

  .section-header,
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .course-card {
    grid-template-columns: 1fr;
  }

  .course-intro,
  .curriculum {
    padding: 28px 23px;
  }

  .course-intro h3 {
    font-size: 28px;
  }

  .method-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .method-card {
    padding: 19px 14px;
  }

  .method-card h3 {
    font-size: 14px;
  }

  .method-card p {
    font-size: 11px;
  }

  .contact-box {
    grid-template-columns: 1fr;
    padding: 29px 22px;
  }

  .contact-logo {
    justify-self: start;
    max-width: 250px;
  }

  .copyright {
    flex-direction: column;
  }
}

@media(max-width:380px) {
  .method-grid {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

